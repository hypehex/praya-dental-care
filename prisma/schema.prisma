generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model akun_pengguna {
  id_akun        String          @id @db.VarChar(10)
  username       String          @unique @db.VarChar(50)
  password       String          @db.VarChar(255)
  status_akun    String          @db.VarChar(20)
  id_owner       String?         @db.VarChar(10)
  id_manajer     String?         @db.VarChar(10)
  id_pasien      String?         @db.VarChar(10)
  id_dokter      String?         @db.VarChar(10)
  dokter         dokter?         @relation(fields: [id_dokter], references: [id_dokter], onDelete: NoAction, onUpdate: NoAction, map: "fk_akun_dokter")
  manajer_klinik manajer_klinik? @relation(fields: [id_manajer], references: [id_manajer], onDelete: NoAction, onUpdate: NoAction, map: "fk_akun_manajer")
  owner          owner?          @relation(fields: [id_owner], references: [id_owner], onDelete: NoAction, onUpdate: NoAction, map: "fk_akun_owner")
  pasien         pasien?         @relation(fields: [id_pasien], references: [id_pasien], onDelete: NoAction, onUpdate: NoAction, map: "fk_akun_pasien")
  tampilan_menu  tampilan_menu[]
}

model dokter {
  id_dokter     String          @id @db.VarChar(10)
  nama          String          @db.VarChar(100)
  no_hp         String          @db.VarChar(15)
  spesialis     String          @db.VarChar(50)
  akun_pengguna akun_pengguna[]
  jadwal_dokter jadwal_dokter[]
  pemeriksaan   pemeriksaan[]
}

model jadwal_dokter {
  id_jadwal     String      @id @db.VarChar(10)
  hari          String      @db.VarChar(10)
  jam_mulai     DateTime    @db.Time(6)
  jam_selesai   DateTime    @db.Time(6)
  status_jadwal String      @db.VarChar(20)
  id_dokter     String      @db.VarChar(10)
  dokter        dokter      @relation(fields: [id_dokter], references: [id_dokter], onDelete: NoAction, onUpdate: NoAction)
  kunjungan     kunjungan[]
}

model kode_pos {
  kode_pos                         String   @id @db.VarChar(5)
  kelurahan                        String   @db.VarChar(50)
  kecamatan                        String   @db.VarChar(50)
  kota                             String   @db.VarChar(50)
  provinsi                         String   @db.VarChar(50)
  pasien_pasien_kode_posTokode_pos pasien[] @relation("pasien_kode_posTokode_pos")
}

model kritik_saran {
  id_kritik_saran       String   @id @db.VarChar(10)
  isi_kritik_saran      String   @db.VarChar(255)
  tanggal_pengiriman    DateTime @db.Date
  status_tindak_lanjut  String?  @db.VarChar(30)
  catatan_tindak_lanjut String?  @db.VarChar(255)
  id_pasien             String   @db.VarChar(10)
  id_owner              String   @db.VarChar(10)
  owner                 owner    @relation(fields: [id_owner], references: [id_owner], onDelete: NoAction, onUpdate: NoAction)
  pasien                pasien   @relation(fields: [id_pasien], references: [id_pasien], onDelete: NoAction, onUpdate: NoAction)
}

model kunjungan {
  id_kunjungan      String        @id @db.VarChar(10)
  tanggal_kunjungan DateTime      @db.Date
  waktu_kunjungan   DateTime      @db.Time(6)
  keluhan_awal      String        @db.VarChar(255)
  status_kunjungan  String        @db.VarChar(20)
  id_pasien         String        @db.VarChar(10)
  id_jadwal         String        @db.VarChar(10)
  id_owner          String?       @db.VarChar(10)
  owner             owner?        @relation(fields: [id_owner], references: [id_owner], onDelete: NoAction, onUpdate: NoAction, map: "fk_kunjungan_owner")
  jadwal_dokter     jadwal_dokter @relation(fields: [id_jadwal], references: [id_jadwal], onDelete: NoAction, onUpdate: NoAction)
  pasien            pasien        @relation(fields: [id_pasien], references: [id_pasien], onDelete: NoAction, onUpdate: NoAction)
  pembayaran        pembayaran[]
  pemeriksaan       pemeriksaan[]
}

model manajer_klinik {
  id_manajer    String          @id @db.VarChar(10)
  nama          String          @db.VarChar(100)
  no_hp         String          @db.VarChar(15)
  username      String          @db.VarChar(50)
  password      String          @db.VarChar(255)
  akun_pengguna akun_pengguna[]
  pembayaran    pembayaran[]
}

model owner {
  id_owner      String          @id @db.VarChar(10)
  nama_owner    String          @db.VarChar(255)
  no_hp         String          @db.VarChar(15)
  username      String          @db.VarChar(50)
  password      String          @db.VarChar(255)
  akun_pengguna akun_pengguna[]
  kritik_saran  kritik_saran[]
  kunjungan     kunjungan[]
  pemeriksaan   pemeriksaan[]
}

model pasien {
  id_pasien                          String          @id @db.VarChar(10)
  nama_pasien                        String          @db.VarChar(100)
  tanggal_lahir                      DateTime        @db.Date
  alamat_jalan                       String          @db.VarChar(100)
  no_hp                              String          @db.VarChar(15)
  kode_pos                           String          @db.VarChar(5)
  username                           String          @db.VarChar(50)
  password                           String          @db.VarChar(255)
  akun_pengguna                      akun_pengguna[]
  kritik_saran                       kritik_saran[]
  kunjungan                          kunjungan[]
  kode_pos_pasien_kode_posTokode_pos kode_pos        @relation("pasien_kode_posTokode_pos", fields: [kode_pos], references: [kode_pos], onDelete: NoAction, onUpdate: NoAction)
  pembayaran                         pembayaran[]
}

model pembayaran {
  id_pembayaran      String         @id @db.VarChar(10)
  jumlah_pembayaran  Decimal        @db.Decimal(12, 2)
  metode_pembayaran  String         @db.VarChar(20)
  tanggal_pembayaran DateTime       @db.Date
  status_pembayaran  Int
  id_manajer         String         @db.VarChar(10)
  id_pasien          String         @db.VarChar(10)
  id_kunjungan       String?        @db.VarChar(10)
  kunjungan          kunjungan?     @relation(fields: [id_kunjungan], references: [id_kunjungan], onDelete: NoAction, onUpdate: NoAction, map: "fk_pembayaran_kunjungan")
  manajer_klinik     manajer_klinik @relation(fields: [id_manajer], references: [id_manajer], onDelete: NoAction, onUpdate: NoAction)
  pasien             pasien         @relation(fields: [id_pasien], references: [id_pasien], onDelete: NoAction, onUpdate: NoAction)
}

model pemeriksaan {
  id_pemeriksaan      String        @id @db.VarChar(10)
  tanggal_pemeriksaan DateTime      @db.Date
  keluhan             String        @db.VarChar(255)
  hasil_pemeriksaan   String        @db.VarChar(255)
  catatan_pemeriksaan String?       @db.VarChar(255)
  id_kunjungan        String        @db.VarChar(10)
  id_dokter           String        @db.VarChar(10)
  id_perawat          String        @db.VarChar(10)
  id_owner            String?       @db.VarChar(10)
  owner               owner?        @relation(fields: [id_owner], references: [id_owner], onDelete: NoAction, onUpdate: NoAction, map: "fk_pemeriksaan_owner")
  dokter              dokter        @relation(fields: [id_dokter], references: [id_dokter], onDelete: NoAction, onUpdate: NoAction)
  kunjungan           kunjungan     @relation(fields: [id_kunjungan], references: [id_kunjungan], onDelete: NoAction, onUpdate: NoAction)
  perawat             perawat       @relation(fields: [id_perawat], references: [id_perawat], onDelete: NoAction, onUpdate: NoAction)
  rekam_medis         rekam_medis[]
  tindakan            tindakan[]
}

model perawat {
  id_perawat   String        @id @db.VarChar(10)
  nama_perawat String        @db.VarChar(100)
  no_hp        String        @db.VarChar(15)
  username     String        @db.VarChar(50)
  password     String        @db.VarChar(255)
  pemeriksaan  pemeriksaan[]
}

model rekam_medis {
  id_rekam_medis      String      @id @db.VarChar(10)
  tanggal_rekam_medis DateTime    @db.Date
  diagnosis           String      @db.VarChar(255)
  catatan             String?     @db.VarChar(255)
  status_validasi     String      @db.VarChar(20)
  id_pemeriksaan      String      @db.VarChar(10)
  pemeriksaan         pemeriksaan @relation(fields: [id_pemeriksaan], references: [id_pemeriksaan], onDelete: NoAction, onUpdate: NoAction)
  resep               resep[]
}

model resep {
  id_resep       String      @id @db.VarChar(10)
  no_resep       String      @unique(map: "resep_no_resep_uk") @db.VarChar(20)
  tanggal_resep  DateTime    @db.Date
  isi_resep      String      @db.VarChar(255)
  id_rekam_medis String      @db.VarChar(10)
  rekam_medis    rekam_medis @relation(fields: [id_rekam_medis], references: [id_rekam_medis], onDelete: NoAction, onUpdate: NoAction)
}

model tampilan_menu {
  id_menu             String         @id @db.VarChar(10)
  registrasi          String?        @db.VarChar(50)
  login               String?        @db.VarChar(50)
  booking_kunjungan   String?        @db.VarChar(50)
  lihat_jadwal_dokter String?        @db.VarChar(50)
  kritik_dan_saran    String?        @db.VarChar(255)
  catatan_pasien      String?        @db.VarChar(255)
  pemeriksaan         String?        @db.VarChar(255)
  rekam_medis         String?        @db.VarChar(255)
  resep               String?        @db.VarChar(255)
  id_akun             String?        @db.VarChar(10)
  akun_pengguna       akun_pengguna? @relation(fields: [id_akun], references: [id_akun], onDelete: NoAction, onUpdate: NoAction)
}

model tindakan {
  id_tindakan        String      @id @db.VarChar(10)
  nama_tindakan      String      @db.VarChar(100)
  deskripsi_tindakan String      @db.VarChar(255)
  biaya              Decimal     @db.Decimal(12, 2)
  id_pemeriksaan     String      @db.VarChar(10)
  pemeriksaan        pemeriksaan @relation(fields: [id_pemeriksaan], references: [id_pemeriksaan], onDelete: NoAction, onUpdate: NoAction)
}
